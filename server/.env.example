debug=false
url_prefix=/api
# JWT signing secret. Railway/PaaS hosts may inject SECRET_KEY instead.
secret_key=change-me-in-production
database_url=postgresql://postgres:postgres@localhost:5432/postgres
# Override these in production. docker compose reads POSTGRES_* from the
# environment and defaults to a local-only bind on 127.0.0.1:5432.
POSTGRES_DB=eigent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
# Chat Share Secret Key 
CHAT_SHARE_SECRET_KEY=put-your-secret-key-here
CHAT_SHARE_SALT=put-your-encode-salt-here


